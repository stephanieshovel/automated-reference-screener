name: Enterprise Talent-Ops CI/CD Optimization Engine

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]

jobs:
  quality-and-testing:
    runs-on: ubuntu-latest
    steps:
    - name: Checkout Source Code
      uses: actions/checkout@v4

    - name: Initialize Optimized Python Environment
      uses: actions/setup-python@v5
      with:
        python-version: '3.11'

    # Optimization Block: Prevents redundant workflow execution times via lockfile checksum layers
    - name: Load Dependency Caching Layer
      uses: actions/cache@v4
      with:
        path: ~/.cache/pip
        key: ${{ runner.os }}-pip-${{ hashFiles('**/requirements.txt') }}
        restore-keys: |
          ${{ runner.os }}-pip-

    - name: Install Runtime Core Dependencies
      run: |
        python -m pip install --upgrade pip
        pip install fastapi uvicorn pytest httpx flake8

    # Security & Compliance Gate: Enforces clean coding styling metrics automatically
    - name: Code Hygiene Assessment (Linter Check)
      run: |
        # stop the build if there are Python syntax errors or undefined names
        flake8 . --count --select=E9,F63,F7,F82 --show-source --statistics
        # exit-zero treats all errors as warnings.
        flake8 . --count --exit-zero --max-complexity=10 --max-line-length=127 --statistics

    # Velocity Checkpoint: Executes unit tests concurrently 
    - name: Execute Automated Validation Suites (PyTest)
      run: |
        pytest -v

